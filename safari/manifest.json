{
  "manifest_version": 3,
  "name": "Incognito Vault",
  "version": "1.0.0",
  "description": "Save Claude and ChatGPT incognito chats as Markdown, keep a private local history, and resume any chat later.",
  "homepage_url": "https://github.com/lkrjangid1/incognito_vault",
  "permissions": ["storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "scripts": [
      "lib/env.js",
      "background/db.js",
      "background/export.js",
      "platform/save.js",
      "background/resume.js",
      "background/main.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "lib/env.js",
        "lib/zip.js",
        "lib/download-client.js",
        "content/markdown.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Incognito Vault",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
