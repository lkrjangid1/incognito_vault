{
  "manifest_version": 3,
  "name": "Incognito Vault",
  "version": "1.0.0",
  "description": "Save Claude and ChatGPT incognito chats to Markdown with artifacts, keep a private local history, and resume any chat later.",
  "minimum_chrome_version": "102",
  "homepage_url": "https://github.com/lkrjangid1/incognito_vault",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "lib/env.js",
        "lib/zip.js",
        "lib/download-client.js",
        "content/markdown.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Incognito Vault",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
